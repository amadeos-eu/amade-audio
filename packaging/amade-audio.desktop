[Desktop Entry]
Type=Application
Version=1.0
Name=amadeOS Audio Station
GenericName=Audio Player
Comment=Rack-style player for audio CDs, music files and internet radio
Icon=amade-audio
Exec=/usr/bin/amade-audio %F
Terminal=false
Categories=AudioVideo;Audio;Player;
MimeType=audio/mpeg;audio/ogg;audio/x-vorbis+ogg;audio/flac;audio/x-flac;audio/wav;audio/x-wav;audio/aac;audio/midi;audio/x-midi;audio/x-mpegurl;audio/x-scpls;x-content/audio-cdda;
Keywords=music;audio;cd;radio;mp3;ogg;flac;midi;player;
StartupNotify=true
